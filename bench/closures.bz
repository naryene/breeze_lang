// Closure calls that read and write a captured variable (upvalues).
fn make_counter() {
  let count = 0;
  fn inc() {
    count = count + 1;
    return count;
  }
  return inc;
}

fn run(n) {
  let inc = make_counter();
  let last = 0;
  let i = 0;
  while (i < n) {
    last = inc();
    i = i + 1;
  }
  return last;
}
print run(15000000);
